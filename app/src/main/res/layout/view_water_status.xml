<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Unified Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6F8FA"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#E6F8FA"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="#0D47A1"
            app:title="View Water Status"
            app:titleTextColor="#0D47A1"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Intro Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a reported area to see its current water situation."
                android:textColor="#5A7D8A"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="24dp" />

            <!-- Area Dropdown Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAreaSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6F8FA"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Title with Icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#00A3B8"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Areas" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reported Areas"
                            android:textColor="#0A2A33"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Modern Dropdown -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilArea"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="#00E5FF"
                        app:hintTextColor="#00A3B8"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="#0A2A33"
                            android:textSize="14sp"
                            android:hint="Select an area"
                            android:popupBackground="@drawable/bg_dropdown_popup" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:indeterminateTint="#00E5FF"
                android:visibility="gone" />

            <!-- No Reported Areas Yet -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoAreas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFF7ED"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#FED7AA"
                app:strokeWidth="1dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/circle_bg_light_yellow"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#F57C00"
                            android:contentDescription="No Areas" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvNoAreasTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Reports Yet"
                        android:textColor="#0A2A33"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvNoAreasMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No water status reports have been submitted anywhere yet. Log in to be the first to help your community."
                        android:textColor="#5A7D8A"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNoAreasLogin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Log In to Submit Report"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gradient_aqua"
                        app:backgroundTint="@null"
                        app:cornerRadius="26dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- No Data for Selected Area -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFF7ED"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#FED7AA"
                app:strokeWidth="1dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/circle_bg_light_yellow"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_recent_history"
                            app:tint="#F57C00"
                            android:contentDescription="No Recent Updates" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Recent Updates"
                        android:textColor="#0A2A33"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvNoDataMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No reports have been submitted for this area in the last 24 hours. Log in to be the first to update your community."
                        android:textColor="#5A7D8A"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNoDataLogin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Log In to Submit Report"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gradient_aqua"
                        app:backgroundTint="@null"
                        app:cornerRadius="26dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_gradient"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/circle_green_dot"
                            android:backgroundTint="#00E5FF" />

                        <TextView
                            android:id="@+id/tvStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AREA WATER STATUS: NORMAL"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:letterSpacing="0.04"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Water supply is stable in this area."
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:id="@+id/tvReportCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Based on 0 reports in the last 24 hours."
                        android:textColor="#B8E8F0"
                        android:textSize="12sp"
                        android:layout_marginTop="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Log In CTA Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#E6F8FA"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#D3EFF5"
                app:strokeWidth="1dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_water_reports"
                            app:tint="#00A3B8"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Report" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Want to report an issue?"
                            android:textColor="#0A2A33"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log in to submit a water status report and help your community."
                        android:textColor="#5A7D8A"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoToLogin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Log In"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gradient_aqua"
                        app:backgroundTint="@null"
                        app:cornerRadius="26dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
