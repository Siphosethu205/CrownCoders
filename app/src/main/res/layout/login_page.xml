<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_screen_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- ============ BRAND HEADER ============ -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/aquacom_logo_transparent"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:contentDescription="AquaCom Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A q u a c o m"
            android:textColor="#0A2A33"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Water Management Solution"
            android:textColor="#5A7D8A"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif-medium" />

        <!-- ============ MAIN FORM CARD ============ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#D3EFF5"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Welcome Back Title -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome "
                        android:textColor="#0A2A33"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back"
                        android:textColor="#00A3B8"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Log in to access your account and manage water resources."
                    android:textColor="#5A7D8A"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"
                    android:lineSpacingMultiplier="1.2" />

                <!-- ============ ERROR BANNER (hidden by default) ============ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardErrorBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#FECDD3"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#FFF1F2"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_dialog_alert"
                            app:tint="#B91C1C"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Error" />

                        <TextView
                            android:id="@+id/tvLoginError"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textColor="#7F1D1D"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ EMAIL ADDRESS FIELD ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/ic_container_bg_aqua"
                        android:src="@android:drawable/ic_dialog_email"
                        android:padding="12dp"
                        android:layout_marginEnd="12dp"
                        app:tint="#00A3B8"
                        android:contentDescription="Email Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/input_field_bg_aqua"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email Address *"
                            android:textColor="#5A7D8A"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/editTextEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="email@example.com"
                            android:textColorHint="#A0C4D0"
                            android:textSize="15sp"
                            android:textColor="#0A2A33"
                            android:inputType="textEmailAddress"
                            android:padding="0dp"
                            android:layout_marginTop="2dp"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ PASSWORD FIELD ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/ic_container_bg_aqua"
                        android:src="@drawable/ic_lock"
                        android:padding="12dp"
                        android:layout_marginEnd="12dp"
                        app:tint="#00A3B8"
                        android:contentDescription="Lock Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:background="@drawable/input_field_bg_aqua"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Password *"
                                android:textColor="#5A7D8A"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/editTextPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:hint="••••••••"
                                android:textColorHint="#A0C4D0"
                                android:textSize="15sp"
                                android:textColor="#0A2A33"
                                android:inputType="textPassword"
                                android:padding="0dp"
                                android:layout_marginTop="2dp"
                                android:importantForAutofill="no" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivTogglePassword"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="#00A3B8"
                            android:layout_marginStart="8dp"
                            android:alpha="0.85"
                            android:contentDescription="Toggle Password Visibility" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ FORGOT PASSWORD ============ -->
                <TextView
                    android:id="@+id/textViewForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Forgot your password?"
                    android:textColor="#00A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- ============ LOGIN BUTTON ============ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLogin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="→   Log In"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_gradient_aqua"
                    app:backgroundTint="@null"
                    app:cornerRadius="27dp"
                    android:layout_marginBottom="16dp" />

                <!-- ============ DIVIDER OR ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#D3EFF5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OR"
                        android:textColor="#A0C4D0"
                        android:textSize="12sp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#D3EFF5" />
                </LinearLayout>

                <!-- ============ VIEW AREA WATER STATUS (GUEST ACCESS) ============ -->
                <LinearLayout
                    android:id="@+id/textViewGuest"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/input_field_bg_aqua"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user_plus"
                        app:tint="#00A3B8"
                        android:contentDescription="Status Icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="View Area Water Status"
                        android:textColor="#00A3B8"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#00A3B8"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ============ REGISTER LINK ============ -->
                <LinearLayout
                    android:id="@+id/btnTopSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/input_field_bg_aqua"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_user_plus"
                        app:tint="#00A3B8"
                        android:contentDescription="Register Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Don't have an account?"
                            android:textColor="#5A7D8A"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/textViewRegister"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Register Now"
                            android:textColor="#00A3B8"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#00A3B8"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ SLOGAN FOOTER ============ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.6">

            <View
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:background="#00A3B8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  EVERY DROP COUNTS  "
                android:textColor="#00A3B8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <View
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:background="#00A3B8" />
        </LinearLayout>

        <!-- ============ PROGRESS ============ -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
