<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!-- 1. Top App Bar (Deep Teal) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1A4D5E"
            app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
            app:navigationIconTint="#FFFFFF"
            app:title="Chats"
            app:titleTextColor="#FFFFFF"
            app:menu="@menu/top_app_bar_menu"
            app:itemIconTint="#FFFFFF" />

        <!-- 2. Body Content Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/actionBarSize"
            android:layout_marginBottom="136dp"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recent Chats"
                android:textColor="#0A2A33"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- Empty State Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No active chats."
                android:textColor="#5A7D8A"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!-- Start New Chat Button (Cyan Gradient Theme) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartNewChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start a new chat"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_gradient_aqua"
                app:backgroundTint="@null"
                app:cornerRadius="24dp"
                android:paddingHorizontal="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

        <!-- 3. Message Input Bar (Fixed above bottom nav) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="80dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <!-- Text Input -->
            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Type a message..."
                android:textColorHint="#A0C4D0"
                android:textColor="#0A2A33"
                android:textSize="14sp"
                android:inputType="textCapSentences" />

            <!-- Send Icon (Cyan) -->
            <ImageView
                android:id="@+id/btnSendMessage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#00E5FF"
                android:contentDescription="Send Message" />

        </LinearLayout>

        <!-- 4. Bottom Navigation (Matching Dashboard) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="#1A4D5E"
            app:itemIconTint="@color/bottom_nav_item_color"
            app:itemTextColor="@color/bottom_nav_item_color"
            app:labelVisibilityMode="labeled"
            app:itemActiveIndicatorStyle="@style/AppBottomNavIndicator"
            app:menu="@menu/bottom_nav_menu" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:menu="@menu/community_member_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
