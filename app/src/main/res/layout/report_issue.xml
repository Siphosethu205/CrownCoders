<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6F8FA"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#E6F8FA"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="#0D47A1"
            app:title="Report Issue"
            app:titleTextColor="#0D47A1"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- MAIN FORM CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6F8FA"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- SECTION 1: ISSUE TYPE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What is the issue?"
                        android:textColor="#0A2A33"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilIssueType"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="32dp"
                        app:boxStrokeColor="#00E5FF"
                        app:hintTextColor="#00A3B8"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <AutoCompleteTextView
                            android:id="@+id/dropdownIssueType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="#0A2A33"
                            android:textSize="14sp"
                            android:hint="Select the problem"
                            android:popupBackground="@drawable/bg_dropdown_popup" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- SECTION 2: URGENCY -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How urgent is it?"
                        android:textColor="#0A2A33"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupUrgency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="32dp"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipUrgencyLow"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Low"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/urgency_text_color"
                            app:chipBackgroundColor="@color/urgency_standard_bg"
                            app:chipSurfaceColor="@android:color/transparent"
                            app:chipStrokeWidth="1.5dp"
                            app:chipStrokeColor="#00E5FF" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipUrgencyMedium"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medium"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/urgency_text_color"
                            app:chipBackgroundColor="@color/urgency_critical_bg"
                            app:chipSurfaceColor="@android:color/transparent"
                            app:chipStrokeWidth="1.5dp"
                            app:chipStrokeColor="#F57C00" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipUrgencyHigh"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/urgency_text_color"
                            app:chipBackgroundColor="@color/urgency_extreme_bg"
                            app:chipSurfaceColor="@android:color/transparent"
                            app:chipStrokeWidth="1.5dp"
                            app:chipStrokeColor="#DC2626" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipUrgencyCritical"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Critical"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/urgency_text_color"
                            app:chipBackgroundColor="@color/urgency_extreme_bg"
                            app:chipSurfaceColor="@android:color/transparent"
                            app:chipStrokeWidth="1.5dp"
                            app:chipStrokeColor="#B91C1C" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- SECTION 3: DESCRIPTION -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Describe the issue"
                        android:textColor="#0A2A33"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="#00E5FF"
                        app:hintTextColor="#00A3B8"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_mic"
                        app:endIconTint="#00E5FF"
                        app:endIconContentDescription="Voice Input">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescription"
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:gravity="top|start"
                            android:hint="e.g. Water gushing near the main road..."
                            android:inputType="textMultiLine|textCapSentences"
                            android:padding="14dp"
                            android:textColor="#0A2A33"
                            android:textColorHint="#A0C4D0"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- VOICE CONTROL PANEL -->
                    <LinearLayout
                        android:id="@+id/voiceControlLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="32dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvRecordingStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔴 Recording..."
                            android:textColor="#DC2626"
                            android:textStyle="bold"
                            android:layout_marginEnd="16dp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStopRecording"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stop"
                            app:icon="@android:drawable/ic_menu_close_clear_cancel"
                            android:textColor="#DC2626"
                            app:iconTint="#DC2626"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlayVoice"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Listen"
                            app:icon="@android:drawable/ic_media_play"
                            android:textColor="#00A3B8"
                            app:iconTint="#00A3B8"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPauseVoice"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pause"
                            app:icon="@android:drawable/ic_media_pause"
                            android:textColor="#00A3B8"
                            app:iconTint="#00A3B8"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReSpeak"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Re-speak"
                            app:icon="@drawable/ic_mic"
                            android:textColor="#00A3B8"
                            app:iconTint="#00A3B8"/>
                    </LinearLayout>

                    <!-- SECTION 4: LOCATION -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Where is it?"
                        android:textColor="#0A2A33"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="32dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="#00E5FF"
                        app:hintTextColor="#00A3B8"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:endIconMode="custom"
                        app:endIconDrawable="@android:drawable/ic_menu_mylocation"
                        app:endIconTint="#00E5FF"
                        app:endIconContentDescription="Get GPS Location">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Street, landmark, or ward"
                            android:inputType="textCapSentences"
                            android:maxLines="2"
                            android:textColor="#0A2A33" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- SECTION 5: PHOTO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add a photo (Optional)"
                        android:textColor="#0A2A33"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#F8FDFE"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#D3EFF5"
                        app:strokeWidth="1dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:id="@+id/rowPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_bg_light_aqua">

                                <ImageView
                                    android:id="@+id/ivPhotoThumb"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@android:drawable/ic_menu_camera"
                                    app:tint="#00E5FF" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvPhotoLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tap to upload"
                                    android:textColor="#0A2A33"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvPhotoSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Helps the maintenance team prepare"
                                    android:textColor="#5A7D8A"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_media_play"
                                app:tint="#A0C4D0" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- NEW: PHOTO PREVIEW WITH DELETE BUTTON -->
                    <FrameLayout
                        android:id="@+id/layoutPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="16dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivPhotoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="#F1F5F9"
                            android:contentDescription="Selected photo preview" />

                        <ImageButton
                            android:id="@+id/btnDeletePhoto"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="8dp"
                            android:background="@drawable/circle_bg_light_aqua"
                            android:backgroundTint="#B91C1C"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="#FFFFFF"
                            android:contentDescription="Remove photo" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SUBMIT BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitIssue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Submit Report"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:background="@drawable/btn_gradient_aqua"
                app:backgroundTint="@null"
                app:cornerRadius="28dp"
                app:elevation="4dp"
                app:icon="@android:drawable/ic_menu_send"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Reports are saved even when offline and sync automatically."
                android:textColor="#A0C4D0"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
