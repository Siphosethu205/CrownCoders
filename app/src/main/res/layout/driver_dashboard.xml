<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fitsSystemWindows="true">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- HEADER -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#E6F8FA"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="64dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivMenu"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@android:drawable/ic_menu_sort_by_size"
                                app:tint="#0A2A33"
                                android:contentDescription="Menu" />

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="14dp"
                                android:src="@drawable/aquacom_logo_transparent"
                                android:scaleType="fitCenter"
                                android:contentDescription="Logo" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Driver Dashboard"
                                    android:textColor="#00A3B8"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDriverWelcome"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Welcome back, Driver"
                                    android:textColor="#5A7D8A"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/syncBanner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="#FFFFFF"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#D3EFF5"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="10dp"
                                    android:paddingTop="6dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="6dp">

                                    <View
                                        android:id="@+id/syncDot"
                                        android:layout_width="8dp"
                                        android:layout_height="8dp"
                                        android:background="@drawable/bg_dot_green"
                                        android:backgroundTint="#00E5FF" />

                                    <TextView
                                        android:id="@+id/tvSyncStatus"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="Online"
                                        android:textColor="#00A3B8"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- CONTENT -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-44dp"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="110dp">

                        <!-- RED PROFILE ALERT -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardProfileAlert"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#FEF2F2"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#FECACA"
                            app:strokeWidth="1dp"
                            android:layout_marginBottom="14dp"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@android:drawable/ic_dialog_alert"
                                    app:tint="#DC2626" />

                                <TextView
                                    android:id="@+id/tvProfileAlertMessage"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="Add your driver's license to start receiving assignments."
                                    android:textColor="#991B1B"
                                    android:textSize="12sp"
                                    android:lineSpacingExtra="2dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- EMPTY: NO TANKER -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardEmptyAssignment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="4dp"
                            app:strokeColor="#E6F8FA"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="24dp"
                                android:gravity="center">

                                <FrameLayout
                                    android:layout_width="64dp"
                                    android:layout_height="64dp"
                                    android:background="@drawable/circle_bg_light_aqua">

                                    <ImageView
                                        android:layout_width="34dp"
                                        android:layout_height="34dp"
                                        android:layout_gravity="center"
                                        android:src="@android:drawable/ic_menu_agenda"
                                        app:tint="#00E5FF" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="18dp"
                                    android:text="Awaiting Assignment"
                                    android:textColor="#0A2A33"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:gravity="center" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="The admin will assign you a water tank and delivery route shortly."
                                    android:textColor="#5A7D8A"
                                    android:textSize="13sp"
                                    android:gravity="center" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- MERGED HERO CARD -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardHero"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="4dp"
                            app:strokeColor="#E6F8FA"
                            app:strokeWidth="1dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <!-- TOP: Tanker Row -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <FrameLayout
                                        android:layout_width="46dp"
                                        android:layout_height="46dp"
                                        android:background="@drawable/circle_bg_light_aqua">

                                        <ImageView
                                            android:layout_width="26dp"
                                            android:layout_height="26dp"
                                            android:layout_gravity="center"
                                            android:src="@android:drawable/ic_menu_directions"
                                            app:tint="#00E5FF" />
                                    </FrameLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvTankerReg"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="T202601"
                                            android:textColor="#0A2A33"
                                            android:textSize="17sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvTankerSource"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="3dp"
                                            android:text="Filling at A.W.S"
                                            android:textColor="#5A7D8A"
                                            android:textSize="12sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvTankerStatusBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_pill_sync"
                                        android:paddingStart="12dp"
                                        android:paddingTop="5dp"
                                        android:paddingEnd="12dp"
                                        android:paddingBottom="5dp"
                                        android:text="IDLE"
                                        android:textColor="#0F766E"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Divider -->
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginTop="16dp"
                                    android:layout_marginBottom="16dp"
                                    android:background="#F0F8FA" />

                                <!-- STATE: IDLE -->
                                <LinearLayout
                                    android:id="@+id/sectionIdle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="You're ready ✓"
                                        android:textColor="#0A2A33"
                                        android:textSize="17sp"
                                        android:textStyle="bold"
                                        android:gravity="center" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:text="Waiting for the next assignment from admin"
                                        android:textColor="#5A7D8A"
                                        android:textSize="13sp"
                                        android:gravity="center" />
                                </LinearLayout>

                                <!-- STATE: ACTIVE JOB -->
                                <LinearLayout
                                    android:id="@+id/sectionJob"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <TextView
                                        android:id="@+id/tvJobLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="NEXT DELIVERY"
                                        android:letterSpacing="0.1"
                                        android:textColor="#00A3B8"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvJobAddress"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:text="9 Bean Street"
                                        android:textColor="#0A2A33"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvJobPriorityBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:background="@drawable/bg_pill_red"
                                        android:paddingStart="10dp"
                                        android:paddingTop="4dp"
                                        android:paddingEnd="10dp"
                                        android:paddingBottom="4dp"
                                        android:text="EXTREME PRIORITY"
                                        android:textColor="#DC2626"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="14dp"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tvJobEta"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="— ETA"
                                            android:textColor="#5A7D8A"
                                            android:textSize="13sp" />

                                        <TextView
                                            android:id="@+id/tvJobDistance"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="— away"
                                            android:textColor="#5A7D8A"
                                            android:textSize="13sp" />
                                    </LinearLayout>

                                    <!-- Trip Progress (visible only during trip) -->
                                    <LinearLayout
                                        android:id="@+id/tripProgressSection"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="14dp"
                                        android:orientation="vertical"
                                        android:visibility="gone">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal">

                                            <TextView
                                                android:id="@+id/tvTripDistance"
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:text="0.0 / 5.0 km"
                                                android:textColor="#0A2A33"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/tvTripSteps"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="0 steps"
                                                android:textColor="#5A7D8A"
                                                android:textSize="12sp" />
                                        </LinearLayout>

                                        <ProgressBar
                                            android:id="@+id/pbTripProgress"
                                            style="?android:attr/progressBarStyleHorizontal"
                                            android:layout_width="match_parent"
                                            android:layout_height="8dp"
                                            android:layout_marginTop="6dp"
                                            android:max="100"
                                            android:progress="0"
                                            android:progressTint="#0288D1"
                                            android:progressBackgroundTint="#E2E8F0" />
                                    </LinearLayout>

                                    <!-- OTP Code -->
                                    <LinearLayout
                                        android:id="@+id/otpSection"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="16dp"
                                        android:background="#F0F9FF"
                                        android:orientation="vertical"
                                        android:padding="14dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="DELIVERY CODE"
                                            android:letterSpacing="0.1"
                                            android:textColor="#0288D1"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvOtpCode"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:letterSpacing="0.3"
                                            android:text="— — — — — —"
                                            android:textColor="#0A2A33"
                                            android:textSize="28sp"
                                            android:textStyle="bold"
                                            android:fontFamily="monospace" />

                                        <TextView
                                            android:id="@+id/tvOtpHint"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:text="Show this code to the member"
                                            android:textColor="#5A7D8A"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <!-- Buttons row -->
                                    <LinearLayout
                                        android:id="@+id/heroButtonsRow"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="16dp"
                                        android:orientation="horizontal">

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/btnHeroPrimary"
                                            android:layout_width="0dp"
                                            android:layout_height="52dp"
                                            android:layout_weight="1"
                                            android:text="Start Trip"
                                            android:textColor="#FFFFFF"
                                            android:textSize="13sp"
                                            android:textStyle="bold"
                                            app:backgroundTint="#0288D1"
                                            app:cornerRadius="14dp"
                                            app:icon="@android:drawable/ic_media_play"
                                            app:iconGravity="textStart"
                                            app:iconTint="#FFFFFF"
                                            app:iconSize="16dp" />

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/btnHeroNavigate"
                                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                            android:layout_width="0dp"
                                            android:layout_height="52dp"
                                            android:layout_marginStart="8dp"
                                            android:layout_weight="1"
                                            android:text="Navigate"
                                            android:textColor="#0A2A33"
                                            android:textSize="13sp"
                                            android:textStyle="bold"
                                            app:cornerRadius="14dp"
                                            app:icon="@android:drawable/ic_menu_compass"
                                            app:iconGravity="textStart"
                                            app:iconTint="#0A2A33"
                                            app:iconSize="16dp"
                                            app:strokeColor="#0A2A33" />
                                    </LinearLayout>
                                </LinearLayout>

                                <!-- STATE: ARRIVED -->
                                <LinearLayout
                                    android:id="@+id/sectionArrived"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:visibility="gone">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="✅ You've Arrived"
                                        android:textColor="#0F766E"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:gravity="center" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="Show this code to the member:"
                                        android:textColor="#5A7D8A"
                                        android:textSize="13sp"
                                        android:gravity="center" />

                                    <TextView
                                        android:id="@+id/tvArrivedCode"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:letterSpacing="0.3"
                                        android:text="— — — — — —"
                                        android:textColor="#0A2A33"
                                        android:textSize="34sp"
                                        android:textStyle="bold"
                                        android:fontFamily="monospace" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:text="Waiting for member to confirm..."
                                        android:textColor="#00A3B8"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:gravity="center" />
                                </LinearLayout>

                                <!-- STATE: CONFIRMED -->
                                <LinearLayout
                                    android:id="@+id/sectionConfirmed"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:visibility="gone">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="✅ Delivery Confirmed"
                                        android:textColor="#0F766E"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:gravity="center" />

                                    <TextView
                                        android:id="@+id/tvConfirmedLitres"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Ready for the next assignment"
                                        android:textColor="#0A2A33"
                                        android:textSize="15sp"
                                        android:gravity="center" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- STATS STRIP -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#E6F8FA"
                            app:strokeWidth="1dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="18dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvStopsDone"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0/0"
                                        android:textColor="#0A2A33"
                                        android:textSize="19sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:text="STOPS"
                                        android:letterSpacing="0.08"
                                        android:textColor="#A0C4D0"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="#F0F8FA" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvWaterDelivered"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0 L"
                                        android:textColor="#0A2A33"
                                        android:textSize="19sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:text="DELIVERED"
                                        android:letterSpacing="0.08"
                                        android:textColor="#A0C4D0"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="#F0F8FA" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvDistanceCovered"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0 km"
                                        android:textColor="#0A2A33"
                                        android:textSize="19sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:text="DISTANCE"
                                        android:letterSpacing="0.08"
                                        android:textColor="#A0C4D0"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- STICKY ACTION BUTTONS -->
            <LinearLayout
                android:id="@+id/layoutActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#FFFFFF"
                android:elevation="12dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeStatus"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Change Status"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#0A2A33"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_menu_rotate"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportIssue"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Report Issue"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#DC2626"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_dialog_alert"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- DRAWER -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:fitsSystemWindows="true"
            app:headerLayout="@layout/nav_header_driver"
            app:menu="@menu/driver_nav_menu" />
    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- BOTTOM NAV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/driverBottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#1A4D5E"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:itemActiveIndicatorStyle="@style/AppBottomNavIndicator"
        app:menu="@menu/driver_bottom_nav_menu" />

</LinearLayout>